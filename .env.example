# Team Portal. Copy to .env.local for development. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"
# Production only. Generate each with: openssl rand -base64 32 (ENCRYPTION_KEY) or openssl rand -hex 32
ENCRYPTION_KEY=""
PII_HASH_PEPPER=""
SESSION_SECRET=""
FILE_SIGNING_SECRET=""
