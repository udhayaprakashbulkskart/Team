// Team Portal database schema (PostgreSQL + Prisma).
// Personal data is stored encrypted (AES-256-GCM) and looked up through keyed HMAC hashes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Audit ----------

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ---------- Team portal (members, KYC, private and group chat) ----------

enum TeamRole {
  ADMIN
  MEMBER
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TeamFileKind {
  PHOTO
  KYC_DOCUMENT
  CHAT_ATTACHMENT
  GROUP_ATTACHMENT
}

// A team member is both the portal login and the directory profile.
// Phone numbers and names are encrypted at rest; the phone is looked up through a keyed hash.
model TeamMember {
  id             String     @id @default(cuid())
  fullName       String
  phoneEncrypted String
  phoneHash      String     @unique
  phoneLast4     String
  passwordHash   String
  role           TeamRole   @default(MEMBER)
  jobTitle       String?
  bio            String?
  active         Boolean    @default(true)
  kycStatus      KycStatus  @default(PENDING)
  kycUpdatedAt   DateTime?
  sessionVersion Int        @default(0)
  photoFileId    String?    @unique
  photo          TeamFile?  @relation("MemberPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  lastSeenAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  kycDocuments     TeamFile[]            @relation("MemberFiles")
  uploadedFiles    TeamFile[]            @relation("FileUploader")
  groupMemberships GroupMembership[]
  privateAsA       PrivateConversation[] @relation("PrivateA")
  privateAsB       PrivateConversation[] @relation("PrivateB")
  privateMessages  PrivateMessage[]
  groupMessages    GroupMessage[]

  @@index([active, fullName])
}

// Every stored file (photo, KYC document, chat attachment). Bytes are AES-256-GCM encrypted in the database.
model TeamFile {
  id             String       @id @default(cuid())
  kind           TeamFileKind
  memberId       String?      // subject of PHOTO and KYC_DOCUMENT files
  member         TeamMember?  @relation("MemberFiles", fields: [memberId], references: [id], onDelete: Cascade)
  photoOf        TeamMember?  @relation("MemberPhoto")
  label          String?      // KYC document type chosen by admin, e.g. AADHAAR
  nameEncrypted  String
  mimeType       String
  sizeBytes      Int
  sha256         String
  data           Bytes        // iv | tag | ciphertext
  uploadedById   String
  uploader       TeamMember   @relation("FileUploader", fields: [uploadedById], references: [id])
  chatMessage    PrivateMessage? @relation("ChatFile")
  groupMessage   GroupMessage?   @relation("GroupFile")
  createdAt      DateTime     @default(now())

  @@index([memberId, kind])
}

model PrivateConversation {
  id            String           @id @default(cuid())
  memberAId     String           // always the lexicographically smaller member id
  memberBId     String
  memberA       TeamMember       @relation("PrivateA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberB       TeamMember       @relation("PrivateB", fields: [memberBId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime         @default(now())
  lastReadAtA   DateTime?
  lastReadAtB   DateTime?
  createdAt     DateTime         @default(now())
  messages      PrivateMessage[]

  @@unique([memberAId, memberBId])
  @@index([memberBId])
}

model PrivateMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   PrivateConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         TeamMember          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String?
  fileId         String?             @unique
  file           TeamFile?           @relation("ChatFile", fields: [fileId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model GroupConversation {
  id          String            @id
  name        String
  createdAt   DateTime          @default(now())
  memberships GroupMembership[]
  messages    GroupMessage[]
}

model GroupMembership {
  groupId    String
  group      GroupConversation @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId   String
  member     TeamMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  addedById  String?
  addedAt    DateTime          @default(now())
  lastReadAt DateTime?

  @@id([groupId, memberId])
  @@index([memberId])
}

model GroupMessage {
  id        String            @id @default(cuid())
  groupId   String
  group     GroupConversation @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    TeamMember        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String?
  fileId    String?           @unique
  file      TeamFile?         @relation("GroupFile", fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())

  @@index([groupId, createdAt])
}
